{
  "name": "feature-001-math-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:problems": "node scripts/generate-problems.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "predev": "npm run generate:problems",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "npm run generate:problems && node scripts/prepare-analytics-policy.mjs",
    "build": "vite build",
    "build:dev": "ANALYTICS_POLICY_MODE=disabled npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "npm run generate:problems && npm run check:catalog && npm run typecheck && npm test && npm run build:dev"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "6.0.3",
    "vitest": "2.1.8"
  }
}
